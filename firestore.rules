rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validParticipants(data) {
      return data.participants is list
          && data.participants.size() == 2
          && data.participants[0] is string
          && data.participants[1] is string
          && data.participants[0] != data.participants[1];
    }

    function isConversationParticipant() {
      return signedIn()
          && request.auth.uid in resource.data.participants;
    }

    function validMessageType(type) {
      return type == 'text' || type == 'image';
    }

    function validReactionMap(reactions) {
      return reactions is map && reactions.size() <= 2;
    }

    function validFcmTokens(data) {
      return !('fcmTokens' in data)
          || (
            data.fcmTokens is map
            && data.fcmTokens.size() <= 10
          );
    }

    function validConversationMaps(data) {
      return data.unreadCounts is map
          && data.unreadCounts.size() <= 2
          && data.typingBy is map
          && data.typingBy.size() <= 2;
    }

    function validImageMessage(data) {
      return data.type != 'image'
          || (
            data.mediaUrl is string
            && data.mediaUrl.size() > 0
            && data.mediaUrl.size() <= 2048
            && data.mediaStoragePath is string
            && data.mediaStoragePath.size() > 0
            && data.mediaStoragePath.size() <= 512
            && data.mediaWidth is int
            && data.mediaWidth > 0
            && data.mediaWidth <= 4096
            && data.mediaHeight is int
            && data.mediaHeight > 0
            && data.mediaHeight <= 4096
            && data.mediaBytes is int
            && data.mediaBytes > 0
            && data.mediaBytes <= 10485760
          );
    }

    function validReplyFields(data) {
      return !('replyToMessageId' in data)
          || (
            data.replyToMessageId is string
            && data.replyToMessageId.size() > 0
            && data.replyToMessageId.size() <= 128
            && data.replyToSenderId is string
            && data.replyToSenderId.size() > 0
            && data.replyToSenderId.size() <= 128
            && data.replyToText is string
            && data.replyToText.size() <= 200
            && data.replyToType is string
            && validMessageType(data.replyToType)
          );
    }

    function mediaFieldsUnchanged() {
      return (
        (!('mediaUrl' in resource.data) && !('mediaUrl' in request.resource.data))
        || (
          request.resource.data.mediaUrl == resource.data.mediaUrl
          && request.resource.data.mediaStoragePath == resource.data.mediaStoragePath
          && request.resource.data.mediaWidth == resource.data.mediaWidth
          && request.resource.data.mediaHeight == resource.data.mediaHeight
          && request.resource.data.mediaBytes == resource.data.mediaBytes
        )
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
          && request.resource.data.uid == userId
          && validFcmTokens(request.resource.data);
      allow update: if isOwner(userId)
          && request.resource.data.uid == userId
          && validFcmTokens(request.resource.data);
      allow delete: if false;
    }

    match /ojasIds/{ojasId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/ojasIds/$(ojasId));
      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow get, list: if signedIn();
      allow create: if isOwner(userId)
          && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
          && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if isConversationParticipant();
      allow list: if signedIn()
          && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
          && validParticipants(request.resource.data)
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participantProfiles is map
          && request.resource.data.unreadCounts is map
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 2000
          && request.resource.data.lastMessageSenderId is string;

      allow update: if isConversationParticipant()
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.participantProfiles == resource.data.participantProfiles
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage',
            'lastMessageSenderId',
            'lastMessageAt',
            'unreadCounts',
            'lastReadAtBy',
            'typingBy',
            'presenceBy',
            'deliveredAtBy'
          ])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 2000
          && request.resource.data.lastMessageSenderId is string
          && validConversationMaps(request.resource.data)
          && (
            request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId
            || request.resource.data.lastMessageSenderId in request.resource.data.participants
            || request.resource.data.lastMessageSenderId == ''
          );

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants;

        allow create: if signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants
            && request.resource.data.conversationId == conversationId
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && request.resource.data.type is string
            && validMessageType(request.resource.data.type)
            && request.resource.data.isDeleted == false
            && validReactionMap(request.resource.data.reactions)
            && request.resource.data.createdAt == request.time
            && validImageMessage(request.resource.data)
            && validReplyFields(request.resource.data);

        allow update: if signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.conversationId == resource.data.conversationId
            && request.resource.data.type == resource.data.type
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && validReactionMap(request.resource.data.reactions)
            && request.resource.data.createdAt == resource.data.createdAt
            && mediaFieldsUnchanged()
            && (
              (
                request.auth.uid != resource.data.senderId
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              )
              || (
                request.auth.uid == resource.data.senderId
                && (
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                  || (
                    request.resource.data.isDeleted == true
                    && request.resource.data.text == 'This message was deleted.'
                    && request.resource.data.reactions.size() == 0
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'text',
                      'isDeleted',
                      'reactions'
                    ])
                  )
                )
              )
            );

        allow delete: if false;
      }
    }

    match /userBlocks/{userId}/blocked/{blockedUserId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
          && request.resource.data.blockedUserId == blockedUserId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /reports/{reportId} {
      allow create: if signedIn()
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
