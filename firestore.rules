rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function interactionPath(contentId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/interactions/$(contentId);
    }

    function currentLiked(contentId) {
      return exists(interactionPath(contentId))
          && get(interactionPath(contentId)).data.liked == true;
    }

    function currentSaved(contentId) {
      return exists(interactionPath(contentId))
          && get(interactionPath(contentId)).data.saved == true;
    }

    function afterLiked(contentId) {
      return getAfter(interactionPath(contentId)).data.liked == true;
    }

    function afterSaved(contentId) {
      return getAfter(interactionPath(contentId)).data.saved == true;
    }

    function validParticipants(data) {
      return data.participants is list
          && data.participants.size() == 2
          && data.participants[0] is string
          && data.participants[1] is string
          && data.participants[0] != data.participants[1];
    }

    function isConversationParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    function validMessageType(type) {
      return type == 'text' || type == 'image' || type == 'video' || type == 'audio';
    }

    function validReactionMap(reactions) {
      return reactions is map && reactions.size() <= 2;
    }

    function validFcmTokens(data) {
      return !('fcmTokens' in data)
          || (data.fcmTokens is map && data.fcmTokens.size() <= 10);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId && validFcmTokens(request.resource.data);
      allow update: if isOwner(userId) && request.resource.data.uid == userId && validFcmTokens(request.resource.data);
      allow delete: if false;
    }

    match /users/{userId}/interactions/{contentId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId)
          && request.resource.data.liked is bool
          && request.resource.data.saved is bool;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/feedFeedback/{contentId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/feedEvents/{eventId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }

    match /users/{userId}/activity/{activityId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId)
          && request.resource.data.action is string
          && request.resource.data.targetType is string
          && request.resource.data.targetId is string
          && request.resource.data.clientActionId is string;
      allow delete: if false;
    }

    match /users/{userId}/shareEvents/{eventId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
          && request.resource.data.contentId is string
          && request.resource.data.channel is string
          && request.resource.data.intent is string;
      allow update, delete: if false;
    }

    match /users/{userId}/commentLikes/{likeId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/collections/{collectionId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      allow delete: if isOwner(userId);
      match /items/{contentId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /users/{userId}/storyViews/{storyId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/feedProfile/{profileId} {
      allow get: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/searchEvents/{eventId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }

    match /appConfig/homeFeed {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    match /ojasIds/{ojasId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow get, list: if signedIn();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if signedIn()
          && userId != request.auth.uid
          && request.resource.data.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'followersCount'])
          && request.resource.data.followers is list
          && request.resource.data.followersCount is number
          && request.resource.data.followersCount >= 0;
      allow delete: if false;
    }

    match /reels/{reelId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;

      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'saves'])
          && request.resource.data.likes is number
          && request.resource.data.saves is number
          && request.resource.data.likes >= 0
          && request.resource.data.saves >= 0
          && request.resource.data.likes == resource.data.likes + (afterLiked(reelId) ? 1 : 0) - (currentLiked(reelId) ? 1 : 0)
          && request.resource.data.saves == resource.data.saves + (afterSaved(reelId) ? 1 : 0) - (currentSaved(reelId) ? 1 : 0);

      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'commentsCount'])
          && request.resource.data.comments is number
          && request.resource.data.comments >= 0;

      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares', 'shareCount'])
          && request.resource.data.shares is number
          && request.resource.data.shares >= 0;

      allow delete: if false;

      match /comments/{commentId} {
        allow get, list: if signedIn();
        allow create: if signedIn()
            && request.resource.data.contentId == reelId
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && request.resource.data.isDeleted == false
            && request.resource.data.status == 'published'
            && request.resource.data.clientActionId is string
            && request.resource.data.createdAt == request.time;
        allow update: if signedIn()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId;
        allow update: if signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'replyCount'])
            && request.resource.data.likeCount is number
            && request.resource.data.likeCount >= 0;
        allow delete: if false;
      }
    }

    match /followRequests/{requestId} {
      allow read: if signedIn()
          && (resource.data.requesterId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow create: if signedIn()
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.targetId is string
          && request.resource.data.targetId != request.auth.uid
          && request.resource.data.status == 'pending';
      allow update: if signedIn()
          && (resource.data.requesterId == request.auth.uid || resource.data.targetId == request.auth.uid)
          && request.resource.data.status in ['pending', 'accepted', 'declined', 'cancelled'];
      allow delete: if false;
    }

    match /socialEdges/{edgeId} {
      allow get: if signedIn()
          && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid);
      allow list: if signedIn();
      allow create, update: if signedIn()
          && request.resource.data.followerId == request.auth.uid
          && request.resource.data.followingId is string
          && request.resource.data.followingId != request.auth.uid
          && request.resource.data.state in ['active', 'inactive'];
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if isConversationParticipant();
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && validParticipants(request.resource.data)
          && request.auth.uid in request.resource.data.participants;
      allow update: if isConversationParticipant()
          && request.resource.data.participants == resource.data.participants;

      match /callInvites/{callId} {
        allow read: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && request.resource.data.callerId == request.auth.uid
            && request.resource.data.status == 'ringing';
        allow update: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow get, list: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.conversationId == conversationId;
        allow update: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow delete: if false;
      }
    }

    match /userBlocks/{userId}/blocked/{blockedUserId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /searchIndex/{searchDocumentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    match /notificationAggregates/{aggId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
