rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(String uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isConversationParticipant() {
      return signedIn()
          && request.auth.uid in resource.data.participants;
    }

    function validParticipants(data) {
      return data.participants is list
          && data.participants.size() == 2
          && data.participants[0] is string
          && data.participants[1] is string
          && data.participants[0] != data.participants[1];
    }

    function validMessageType(type) {
      return type == 'text' || type == 'image';
    }

    function validReactionMap(reactions) {
      return reactions is map
          && reactions.size() <= 2;
    }


    // ============================================================
    // PRIVATE USER DOCUMENTS
    // ============================================================

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
          && request.resource.data.uid == userId;

      allow update: if isOwner(userId)
          && request.resource.data.uid == userId;

      allow delete: if false;
    }


    // ============================================================
    // OJAS ID REGISTRY
    // ============================================================

    match /ojasIds/{ojasId} {

      // Needed for OJAS ID login lookup.
      allow get: if true;

      // Prevent scraping the full registry.
      allow list: if false;

      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && !exists(
            /databases/$(database)/documents/ojasIds/$(ojasId)
          );

      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }


    // ============================================================
    // PUBLIC PROFILES
    //
    // Used by:
    // - User search
    // - New conversations
    // - Messaging participant information
    // ============================================================

    match /publicProfiles/{userId} {

      allow get: if signedIn();

      allow list: if signedIn();

      allow create: if isOwner(userId)
          && request.resource.data.uid == userId;

      allow update: if isOwner(userId)
          && request.resource.data.uid == userId;

      allow delete: if false;
    }


    // ============================================================
    // CONVERSATIONS
    // ============================================================

    match /conversations/{conversationId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow get: if signedIn()
          && request.auth.uid in resource.data.participants;

      allow list: if signedIn();


      // ----------------------------------------------------------
      // CREATE
      //
      // MessagingService creates deterministic conversations:
      // uidA_uidB
      // ----------------------------------------------------------

      allow create: if signedIn()
          && validParticipants(request.resource.data)
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participantProfiles is map
          && request.resource.data.unreadCounts is map
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessageSenderId is string;


      // ----------------------------------------------------------
      // UPDATE
      //
      // Only existing conversation participants can update.
      // Participants themselves cannot be replaced.
      // ----------------------------------------------------------

      allow update: if signedIn()
          && request.auth.uid in resource.data.participants
          && request.resource.data.participants
              == resource.data.participants;


      allow delete: if false;


      // ==========================================================
      // MESSAGES
      // ==========================================================

      match /messages/{messageId} {

        // --------------------------------------------------------
        // READ
        // --------------------------------------------------------

        allow get, list: if signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants;


        // --------------------------------------------------------
        // CREATE
        // --------------------------------------------------------

        allow create: if signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants
            && request.resource.data.conversationId == conversationId
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && validMessageType(request.resource.data.type)
            && request.resource.data.isDeleted == false
            && validReactionMap(request.resource.data.reactions);


        // --------------------------------------------------------
        // UPDATE
        //
        // Supports:
        // - Reactions
        // - Soft delete by original sender
        //
        // Prevents changing:
        // - senderId
        // - conversationId
        // - message type
        // --------------------------------------------------------

        allow update: if signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants
            && request.resource.data.senderId
                == resource.data.senderId
            && request.resource.data.conversationId
                == resource.data.conversationId
            && request.resource.data.type
                == resource.data.type
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && validReactionMap(request.resource.data.reactions)
            && (
              request.auth.uid == resource.data.senderId
              || request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(['reactions'])
            );


        // Hard delete disabled.
        // Application uses soft delete.
        allow delete: if false;
      }
    }


    // ============================================================
    // BLOCK SYSTEM
    //
    // Structure:
    //
    // userBlocks/{userId}/blocked/{blockedUserId}
    // ============================================================

    match /userBlocks/{userId}/blocked/{blockedUserId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
          && request.resource.data.blockedUserId == blockedUserId;

      allow update: if isOwner(userId);

      allow delete: if isOwner(userId);
    }


    // ============================================================
    // REPORT SYSTEM
    // ============================================================

    match /reports/{reportId} {

      allow create: if signedIn()
          && request.resource.data.reporterId
              == request.auth.uid;

      allow read: if false;

      allow update: if false;

      allow delete: if false;
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
