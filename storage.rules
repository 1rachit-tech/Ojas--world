rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isValidImageSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    function isValidVideoSize() {
      return request.resource.size <= 50 * 1024 * 1024;
    }

    match /conversations/{conversationId}/messages/{userId}/{fileName} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isImage()
        && isValidImageSize();

      allow update: if false;

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /chat_media/{userId}/{conversationId}/videos/{fileName} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isVideo()
        && isValidVideoSize();

      allow update: if false;

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /profileImages/{userId}/{fileName} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isImage()
        && isValidImageSize();

      allow update: if false;

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /reels/{userId}/{fileName} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isVideo()
        && request.resource.contentType == 'video/mp4'
        && isValidVideoSize();

      allow update: if false;

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
