rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {


    // ============================================================
    // COMMON HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }


    function isImage() {
      return request.resource.contentType.matches(
        'image/.*'
      );
    }


    function isValidImageSize() {
      return request.resource.size
        <= 10 * 1024 * 1024;
    }


    // ============================================================
    // MESSAGE IMAGES
    //
    // Expected structure:
    //
    // conversations/
    //   {conversationId}/
    //     messages/
    //       {userId}/
    //         {fileName}
    // ============================================================

    match /conversations/{conversationId}/messages/{userId}/{fileName} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isImage()
        && isValidImageSize();

      allow update: if false;

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }


    // ============================================================
    // PROFILE IMAGES
    // ============================================================

    match /profileImages/{userId}/{fileName} {

      allow read: if true;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isImage()
        && isValidImageSize();

      allow update: if false;

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{allPaths=**} {

      allow read, write: if false;
    }
  }
}
